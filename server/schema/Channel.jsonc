{
  "name": "Channel",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "announcement",
        "voice",
        "stage",
        "forum",
        "media",
        "rules",
        "thread",
        "whiteboard",
        "board",
        "library",
        "focus"
      ],
      "default": "text"
    },
    "category_id": {
      "type": "string"
    },
    "parent_channel_id": {
      "type": "string"
    },
    "position": {
      "type": "number",
      "default": 0
    },
    "slowmode": {
      "type": "number",
      "default": 0
    },
    "nsfw": {
      "type": "boolean",
      "default": false
    },
    "is_private": {
      "type": "boolean",
      "default": false
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "thread_type": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    },
    "auto_archive_duration": {
      "type": "number",
      "default": 1440
    },
    "last_activity_at": {
      "type": "string"
    },
    "guidelines": {
      "type": "string"
    },
    "archived_at": {
      "type": "string"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "thread_member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "pinned_message_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notification_level": {
      "type": "string",
      "enum": [
        "all",
        "mentions",
        "none"
      ],
      "default": "all"
    }
  },
  "required": [
    "server_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "data.thread_member_ids": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.is_private": false
            },
            {
              "data.type": {
                "$ne": "thread"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}