{
  "name": "BoardCard",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "server_id": {
      "type": "string"
    },
    "column_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "position": {
      "type": "number",
      "default": 0
    },
    "assignee_usernames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    }
  },
  "required": [
    "channel_id",
    "column_id",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}