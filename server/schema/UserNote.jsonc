{
  "name": "UserNote",
  "type": "object",
  "properties": {
    "target_user_id": {
      "type": "string"
    },
    "target_username": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "target_user_id",
    "note"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.target_user_id": {
            "$ne": "{{user.id}}"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}