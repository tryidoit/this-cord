{
  "name": "MessageReport",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "dm",
        "channel"
      ]
    },
    "channel_id": {
      "type": "string"
    },
    "server_id": {
      "type": "string"
    },
    "author_username": {
      "type": "string"
    },
    "reporter_username": {
      "type": "string"
    },
    "reporter_user_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "content_snapshot": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "message_id",
    "reporter_username",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.reporter_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.reporter_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}