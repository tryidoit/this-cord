{
  "name": "CoinGift",
  "type": "object",
  "properties": {
    "from_user_id": {
      "type": "string"
    },
    "from_username": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "to_username": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "note": {
      "type": "string"
    },
    "claimed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "from_user_id",
    "to_user_id",
    "amount"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.from_user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.to_user_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}