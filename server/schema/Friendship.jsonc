{
  "name": "Friendship",
  "type": "object",
  "properties": {
    "requester_user_id": {
      "type": "string"
    },
    "requester_username": {
      "type": "string"
    },
    "recipient_user_id": {
      "type": "string"
    },
    "recipient_username": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "blocked",
        "ignored"
      ],
      "default": "pending"
    },
    "thread_key": {
      "type": "string"
    }
  },
  "required": [
    "requester_user_id",
    "recipient_user_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requester_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}