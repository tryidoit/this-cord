{
  "name": "Profile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "about_me": {
      "type": "string"
    },
    "pronouns": {
      "type": "string"
    },
    "points": {
      "type": "number",
      "default": 0
    },
    "avatar_id": {
      "type": "string"
    },
    "banner_id": {
      "type": "string"
    },
    "owned_avatars": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "theme_id": {
      "type": "string"
    },
    "sidebar_skin_id": {
      "type": "string"
    },
    "ui_style_id": {
      "type": "string",
      "default": "discord"
    },
    "color_mode": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "system"
      ],
      "default": "system"
    },
    "ui_custom": {
      "type": "object",
      "default": {}
    },
    "name_font": {
      "type": "string",
      "default": "default"
    },
    "is_admin": {
      "type": "boolean",
      "default": false
    },
    "moderator": {
      "type": "boolean",
      "default": false
    },
    "vip": {
      "type": "boolean",
      "default": false
    },
    "is_banned": {
      "type": "boolean",
      "default": false
    },
    "ban_reason": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "needs_name": {
      "type": "boolean",
      "default": true
    },
    "cheat_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "daily_streak": {
      "type": "number",
      "default": 0
    },
    "last_daily_claim": {
      "type": "string"
    },
    "last_session_claim": {
      "type": "string"
    },
    "last_seen": {
      "type": "string"
    },
    "muted_until": {
      "type": "string"
    },
    "kicked_at": {
      "type": "string"
    },
    "games_won": {
      "type": "number",
      "default": 0
    },
    "nicknames": {
      "type": "object",
      "default": {},
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "ringtone_uri": {
      "type": "string"
    },
    "transfer_limit": {
      "type": "number",
      "default": 50000
    },
    "status_text": {
      "type": "string"
    },
    "profile_badge": {
      "type": "string"
    },
    "chat_color": {
      "type": "string"
    },
    "can_delete_messages": {
      "type": "boolean",
      "default": false
    },
    "can_edit_messages": {
      "type": "boolean",
      "default": false
    },
    "notification_prefs": {
      "type": "object",
      "default": {}
    },
    "presence_status": {
      "type": "string",
      "enum": [
        "online",
        "idle",
        "dnd",
        "invisible"
      ],
      "default": "online"
    },
    "custom_status": {
      "type": "string"
    },
    "custom_status_emoji": {
      "type": "string"
    },
    "custom_status_expiry": {
      "type": "string"
    },
    "rich_presence": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "avatar_decoration": {
      "type": "string"
    },
    "profile_effect": {
      "type": "string"
    },
    "privacy_dm": {
      "type": "string",
      "enum": [
        "everyone",
        "friends",
        "server_members"
      ],
      "default": "everyone"
    },
    "privacy_friend_requests": {
      "type": "string",
      "enum": [
        "everyone",
        "friends_of_friends",
        "none"
      ],
      "default": "everyone"
    },
    "muted_dms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "closed_dms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "accessibility_high_contrast": {
      "type": "boolean",
      "default": false
    },
    "accessibility_reduced_motion": {
      "type": "boolean",
      "default": false
    },
    "accessibility_tts": {
      "type": "boolean",
      "default": false
    },
    "streamer_mode": {
      "type": "boolean",
      "default": false
    },
    "developer_mode": {
      "type": "boolean",
      "default": false
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "favorites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "quiet_hours_start": {
      "type": "string"
    },
    "quiet_hours_end": {
      "type": "string"
    },
    "focus_mode": {
      "type": "boolean",
      "default": false
    },
    "focus_whitelist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "thiscord_plus_until": {
      "type": "string"
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "quest_progress": {
      "type": "object",
      "default": {}
    }
  },
  "required": [
    "username"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}