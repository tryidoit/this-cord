{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string"
    },
    "channel_id": {
      "type": "string"
    },
    "ticket_number": {
      "type": "number"
    },
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "assigned_to": {
      "type": "string"
    },
    "transcript": {
      "type": "string"
    },
    "closed_at": {
      "type": "string"
    },
    "closed_by": {
      "type": "string"
    }
  },
  "required": [
    "server_id",
    "user_id",
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}