{
  "name": "Reaction",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "channel",
        "dm"
      ]
    },
    "scope": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "emoji": {
      "type": "string"
    },
    "reaction_type": {
      "type": "string",
      "enum": [
        "emoji",
        "text",
        "super"
      ],
      "default": "emoji"
    }
  },
  "required": [
    "message_id",
    "user_id",
    "emoji"
  ],
  "rls": {
    "read": {},
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}