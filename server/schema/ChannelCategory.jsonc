{
  "name": "ChannelCategory",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "position": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "server_id",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}