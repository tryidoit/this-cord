{
  "name": "ChannelMessage",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "server_id": {
      "type": "string"
    },
    "author_username": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string"
    },
    "attachment_type": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "edited": {
      "type": "boolean",
      "default": false
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "is_system": {
      "type": "boolean",
      "default": false
    },
    "system_type": {
      "type": "string"
    },
    "reply_to_id": {
      "type": "string"
    },
    "reply_to_username": {
      "type": "string"
    },
    "reply_to_name": {
      "type": "string"
    },
    "reply_to_content": {
      "type": "string"
    },
    "reply_deleted": {
      "type": "boolean",
      "default": false
    },
    "poll_data": {
      "type": "object"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "visible_at": {
      "type": "string"
    }
  },
  "required": [
    "channel_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}