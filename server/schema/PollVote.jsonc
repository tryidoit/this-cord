{
  "name": "PollVote",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "channel",
        "dm"
      ]
    },
    "option_index": {
      "type": "number"
    },
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    }
  },
  "required": [
    "message_id",
    "option_index",
    "user_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": null,
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}