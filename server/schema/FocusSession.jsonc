{
  "name": "FocusSession",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "server_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "focus",
        "break"
      ],
      "default": "focus"
    },
    "duration_minutes": {
      "type": "number",
      "default": 25
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "total_focus_minutes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "channel_id",
    "user_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}