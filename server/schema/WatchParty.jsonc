{
  "name": "WatchParty",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "server_id": {
      "type": "string"
    },
    "host_user_id": {
      "type": "string"
    },
    "host_username": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "video_type": {
      "type": "string",
      "enum": [
        "youtube",
        "vimeo",
        "audio"
      ],
      "default": "youtube"
    },
    "video_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "is_playing": {
      "type": "boolean",
      "default": false
    },
    "current_time": {
      "type": "number",
      "default": 0
    },
    "duration": {
      "type": "number",
      "default": 0
    },
    "updated_at": {
      "type": "string"
    },
    "queue": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "ended": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "channel_id",
    "host_user_id",
    "video_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}