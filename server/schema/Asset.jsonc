{
  "name": "Asset",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "pfp",
        "chat_image",
        "ringtone",
        "server_icon",
        "emoji",
        "sticker",
        "banner",
        "wallpaper",
        "soundboard"
      ]
    },
    "mime": {
      "type": "string"
    },
    "size": {
      "type": "number"
    },
    "width": {
      "type": "number"
    },
    "height": {
      "type": "number"
    },
    "data_url": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "data_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}