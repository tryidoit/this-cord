{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "thread_key": {
      "type": "string"
    },
    "from_user_id": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "from_username": {
      "type": "string"
    },
    "to_username": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string"
    },
    "attachment_type": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "read_at": {
      "type": "string"
    },
    "edited": {
      "type": "boolean",
      "default": false
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "reply_to_id": {
      "type": "string"
    },
    "reply_to_username": {
      "type": "string"
    },
    "reply_to_name": {
      "type": "string"
    },
    "reply_to_content": {
      "type": "string"
    },
    "reply_deleted": {
      "type": "boolean",
      "default": false
    },
    "poll_data": {
      "type": "object"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_group": {
      "type": "boolean",
      "default": false
    },
    "group_id": {
      "type": "string"
    },
    "group_member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "visible_at": {
      "type": "string"
    }
  },
  "required": [
    "thread_key",
    "content"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.from_user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "data.group_member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}