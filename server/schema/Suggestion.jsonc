{
  "name": "Suggestion",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string"
    },
    "channel_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied",
        "implemented"
      ],
      "default": "pending"
    },
    "upvote_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "downvote_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "admin_response": {
      "type": "string"
    }
  },
  "required": [
    "server_id",
    "user_id",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}