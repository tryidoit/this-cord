{
  "name": "Level",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "number",
      "default": 0
    },
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "messages_count": {
      "type": "number",
      "default": 0
    },
    "last_message_at": {
      "type": "string"
    },
    "rank_color": {
      "type": "string"
    },
    "rank_title": {
      "type": "string"
    }
  },
  "required": [
    "server_id",
    "user_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}