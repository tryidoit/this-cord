{
  "name": "ChannelRead",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "seen_at": {
      "type": "string"
    }
  },
  "required": [
    "channel_id",
    "user_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}