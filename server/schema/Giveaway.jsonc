{
  "name": "Giveaway",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string"
    },
    "channel_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "prize": {
      "type": "string"
    },
    "ends_at": {
      "type": "string"
    },
    "winner_count": {
      "type": "number",
      "default": 1
    },
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ended": {
      "type": "boolean",
      "default": false
    },
    "winner_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "winner_usernames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "seed": {
      "type": "string"
    }
  },
  "required": [
    "server_id",
    "channel_id",
    "title",
    "ends_at"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}